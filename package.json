{
  "name": "scrapfinds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src api scripts",
    "test": "vitest run",
    "icons": "pwa-assets-generator",
