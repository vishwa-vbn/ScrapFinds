# Firebase (public - baked into client bundle at build time)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:000000000000000000000000

# ImageKit (public)
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id
VITE_IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxx

# Site URL (public)
VITE_SITE_URL=https://your-domain.com

# Dev only: set to 'true' to use in-memory mock data (ignored/rejected in production builds)
VITE_USE_MOCK=true

# --- Server-only (Vercel environment variables, NEVER prefix with VITE_) ---
# ImageKit private key (SECRET — never commit)
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxx

# Firebase server API key restricted to Identity Toolkit API only
FIREBASE_SERVER_API_KEY=your-server-api-key

# The admin's Firebase UID (set after first login - see SETUP.md step 6)
ADMIN_UID=REPLACE_WITH_ADMIN_UID

# Google Gemini API Key for Auto-Translation & Description Generation
GEMINI_API_KEY=your-gemini-api-key

# Comma-separated allowed origins for API routes
ALLOWED_ORIGINS=https://your-domain.com,https://your-project.vercel.app
